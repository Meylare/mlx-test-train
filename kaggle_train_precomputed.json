{
  "vision_model_name": "Qwen/Qwen2.5-Omni-7B",
  "llm_model_name": "Qwen/Qwen2.5-7B-Instruct",
  "max_seq_length": 1536,
  "attn_implementation": "flash_attention_2",
  "torch_dtype": "float16",
  "load_in_4bit": true,
  "bnb_4bit_quant_type": "nf4",
  "bnb_4bit_compute_dtype": "float16",
  "bnb_4bit_use_double_quant": true,
  "device_map": "none",
  "num_style_tokens": 16,
  "perceiver_depth": 6,
  "perceiver_heads": 8,
  "projector_hidden_mult": 4,
  "vision_accepts_video": false,
  "vision_hidden_size": null,
  "skip_vision_tower": true,
  "fixed_image_size": null,

  "r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "use_gradient_checkpointing": "unsloth",

  "output_dir": "/kaggle/working/outputs/pvp_dpo_precomputed",
  "per_device_train_batch_size": 1,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 16,
  "learning_rate": 2e-5,
  "num_train_epochs": 2.0,
  "max_length": 1536,
  "max_prompt_length": 512,
  "beta": 0.1,
  "reference_free": true,
  "precompute_ref_log_probs": true,
  "logging_steps": 5,
  "save_steps": 100,
  "warmup_ratio": 0.05,
  "lr_scheduler_type": "cosine",
  "optim": "adamw_torch_fused",
  "bf16": false,
  "fp16": true,
  "gradient_checkpointing": true,
  "ddp_find_unused_parameters": false,
  "remove_unused_columns": false,
  "report_to": null,
  "seed": 42,

  "dataset_path": "/kaggle/working/pvp_precomputed_hf",
  "use_dummy_dataset": false,
  "num_dummy_samples": 20
}
